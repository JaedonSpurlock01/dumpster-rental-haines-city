---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found | Dumpster Rentals Haines City"
  description="The page you requested could not be found."
  noindex
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">404 error</p>
      <h1>This page has been hauled away</h1>
      <p>
        The address may be outdated or typed incorrectly. Return to the homepage or request a free dumpster rental estimate.
      </p>
      <div class="hero__actions">
        <a class="button" href="/">Go to the Homepage</a>
        <a class="button button--secondary" href="/contact/">Request an Estimate</a>
      </div>
    </div>
  </section>
</BaseLayout>
