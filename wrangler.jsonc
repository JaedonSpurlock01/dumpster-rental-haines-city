{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dumpsterrentalhainescity",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "vars": {
    "TRACER_FORMS_URL": "https://tracer-staging.jaedonaspurlock.workers.dev/api/forms"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
